# Copy to .env and fill in. Never commit .env.
PORT=8787
DB_PATH=/var/lib/speakline/speakline.db
# Web app address(es) allowed to call the API, comma-separated
APP_ORIGIN=https://speakline.kz
APP_URL=https://speakline.kz/
# Serve the web app from the same server (path to the folder with index.html); leave empty if hosted elsewhere
STATIC_DIR=/srv/speakline/web

# Paddle: sandbox first, then production. Keys from Paddle → Developer tools.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PRICE_WEEK=
PRICE_MONTH=
PRICE_QUARTER=
PRICE_PACK=

# Email for sign-in codes and trial reminders (any SMTP: your domain mail, Yandex 360, Mailgun, Unisender…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Speakline <no-reply@speakline.kz>

# AI coach. Secret — lives only here, never in the web app. Without it the app shows the built-in tips only.
# Claude (default):   AI_API_KEY=sk-ant-…   AI_MODEL=claude-sonnet-5-5   (AI_API_URL left empty)
# DeepSeek:           AI_API_KEY=sk-…       AI_MODEL=deepseek-flash      AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_API_URL=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=3

# Speech-to-text (Soniox, real-time). Secret — lives only here. The browser gets a 60-second temporary key per recording.
# Without it the apps fall back to the browser's own speech recognition (Chrome only).
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
STT_HOURLY_LIMIT=60
STT_DAILY_CAP=20000

# No Paddle contract yet: 1 = the demo payment sheet records the plan on the server (unlocks the AI coach).
# Without SMTP_URL the sign-in code is then shown on screen. Set to 0 once Paddle is live.
DEMO_MODE=0

# Password for /api/stats?key=…
ADMIN_KEY=
# Local testing only: returns the sign-in code in the API response
DEV_ECHO_CODES=0
