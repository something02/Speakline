# Copy to .env and fill in. Never commit .env.
PORT=8787
DB_PATH=/var/lib/speakline/speakline.db
# Web app address(es) allowed to call the API, comma-separated
APP_ORIGIN=https://speakline.kz
APP_URL=https://speakline.kz/
# Serve the web app from the same server (path to the folder with index.html); leave empty if hosted elsewhere
STATIC_DIR=/srv/speakline/web

# Paddle: sandbox first, then production. Keys from Paddle → Developer tools.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PRICE_WEEK=
PRICE_MONTH=
PRICE_QUARTER=
PRICE_PACK=
PRICE_PRO=

# Email for sign-in codes and trial reminders (any SMTP: your domain mail, Yandex 360, Mailgun, Unisender…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Speakline <no-reply@speakline.kz>

# Password for /api/stats?key=…
ADMIN_KEY=
# Local testing only: returns the sign-in code in the API response
DEV_ECHO_CODES=0
